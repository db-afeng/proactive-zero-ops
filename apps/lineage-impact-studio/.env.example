# Local Databricks authentication and AppKit runtime
DATABRICKS_CONFIG_PROFILE=fe-sandbox-proactive-zero-ops-2
DATABRICKS_HOST=https://fe-sandbox-proactive-zero-ops-2.cloud.databricks.com
DATABRICKS_WAREHOUSE_ID=<warehouse-id-from-bundle-summary>
DATABRICKS_VOLUME_FILES=/Volumes/proactive_zero_ops_catalog/proactive_zero_ops_guard/restricted_assessments
DATABRICKS_APP_PORT=8000
DATABRICKS_APP_NAME=lineage-impact-studio

# Lakebase project lineage-impact-studio, production branch
PGHOST=<lakebase-endpoint-host>
PGPORT=5432
PGDATABASE=databricks_postgres
PGSSLMODE=require
LAKEBASE_ENDPOINT=projects/lineage-impact-studio/branches/production/endpoints/primary

# Local-only secret values. Never commit populated values.
LINEAGE_IMPACT_ENCRYPTION_KEY=<canonical-base64-encoded-32-byte-key>
GITHUB_CLIENT_SECRET=<github-app-client-secret>

# Set after the GitHub App and canonical deployed app URL exist.
GITHUB_CLIENT_ID=<github-app-client-id>
GITHUB_REDIRECT_URI=https://<deployed-app-host>/api/github/oauth/callback

# Public custom U2M OAuth integration for manual Omnigent fixes only.
# Request all-apis without offline_access; the short-lived token is encrypted at rest.
DATABRICKS_FIX_OAUTH_CLIENT_ID=<public-custom-oauth-client-id>
DATABRICKS_FIX_OAUTH_REDIRECT_URI=https://<deployed-app-host>/api/databricks/oauth/callback
